# Get these by running `npx sanity login` then `npx sanity init` in this
# directory (creates the actual Sanity project + a public "production" dataset).
SANITY_STUDIO_PROJECT_ID="replace-with-project-id"
SANITY_STUDIO_DATASET="production"

# Only needed to run `npm run seed` (one-time content seed). Create an
# Editor token at manage.sanity.io -> your project -> API -> Tokens.
# Never commit this value or expose it to the browser.
SANITY_SEED_TOKEN="replace-with-editor-token"
