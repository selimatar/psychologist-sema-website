generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}

model Booking {
  id              String        @id @default(uuid())
  slotStart       DateTime
  slotEnd         DateTime
  lockKey         DateTime?     @unique
  status          BookingStatus @default(PENDING)
  source          BookingSource
  clientName      String?
  clientEmail     String?
  topic           String?
  notes           String?
  rejectionReason String?
  expiresAt       DateTime?
  respondedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([slotStart])
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum BookingSource {
  CLIENT_REQUEST
  MANUAL
}
