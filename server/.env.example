# Supabase Postgres — pooled connection for the running app (pgbouncer, port 6543)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Supabase Postgres — direct connection, used only by `prisma migrate`
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="14d"

# SendGrid
SENDGRID_API_KEY="SG.replace-me"
EMAIL_FROM="Sema Psikolog <no-reply@example.com>"
PSYCHOLOGIST_EMAIL="psychologist@example.com"

# Sanity (availability rules / blocked periods CMS — see ../sanity/)
SANITY_PROJECT_ID="replace-with-project-id"
SANITY_DATASET="production"
SANITY_API_VERSION="2025-07-01"
# Only needed if the dataset is made private later; omit for the public-dataset default
# SANITY_READ_TOKEN=""

# Google Form (personal info / intake form)
# Base viewform URL for the existing Google Form
GOOGLE_FORM_BASE_URL="https://docs.google.com/forms/d/e/1FAIpQLSdH0Wwbe097talQ6YToA1W7gVrRe0p1XKBaQfzihDebDjYx5g/viewform"
# entry.XXXXXXXX id for the "Booking Reference" short-answer field — get this
# from the form's prefilled-link tool in Google Forms after adding that field
GOOGLE_FORM_BOOKING_ID_ENTRY="entry.123456789"

# Misc
PORT=4000
CORS_ORIGIN="http://localhost:5173"
TIMEZONE="Europe/Istanbul"
PENDING_BOOKING_TTL_HOURS=72
MIN_BOOKING_LEAD_MINUTES=120
